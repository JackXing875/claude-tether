{
  "name": "claude-tether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Personal remote Claude Code runtime with locally authorized project tools",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/apps/bridge-cli/demo.js",
    "doctor": "npm run build && node dist/apps/bridge-cli/doctor.js",
    "probe": "node dist/apps/bridge-cli/probe.js",
    "server": "node dist/apps/relay-server/main.js",
    "bridge": "node dist/apps/bridge-cli/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "diff": "8.0.4",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
