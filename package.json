  },
  "keywords": ["claude-code", "ssh", "proxy", "tunnel"],
  "description": "Run local Claude Code through a reconnecting SSH tunnel to your VPS",
  "bin": {
    "claude-tether": "dist/src/cli.js"
  },
  "files": ["dist/src", "src", "tsconfig.json", ".nvmrc", "README.md", "LICENSE", "CHANGELOG.md", "docs/RUNBOOK.md"],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "tether": "node dist/src/cli.js",
    "prepare": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
